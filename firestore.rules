rules_version='2';
service cloud.firestore{match /databases/{db}/documents{
 function admin(){return request.auth!=null&&get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role=='admin';}
 match /users/{u}{allow read:if request.auth!=null&&request.auth.uid==u;allow write:if false;}
 match /{c}/{id}{allow read:if (c in ['products','categories','projects','blogPosts','testimonials']&&resource.data.published==true)||admin();allow write:if (c in ['products','categories','projects','blogPosts','testimonials'])&&admin();}
 match /websiteSettings/{id}{allow read:if true;allow write:if admin();}
 match /inquiries/{id}{allow create:if request.resource.data.status=='new'&&request.resource.data.name is string&&request.resource.data.name.size()<200&&request.resource.data.message is string&&request.resource.data.message.size()<3000&&request.resource.data.phone is string&&request.resource.data.phone.size()<40;allow read,update,delete:if admin();}
}}
